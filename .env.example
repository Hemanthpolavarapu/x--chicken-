# MongoDB Atlas connection string (server-only, never prefix with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name
MONGODB_DB_NAME=x_chicken

# Optional: set to "true" only if production/container DNS blocks SRV lookups
# MONGODB_DNS_FALLBACK=false

# Test vendor access is disabled unless explicitly enabled.
# For local testing, set to "true"; Vercel Preview also requires VERCEL_ENV=preview.
ENABLE_DEV_TEST_VENDOR=false
TEST_VENDOR_EMAIL=
TEST_VENDOR_PASSWORD=

# Preview-only: point the app at a dedicated test database, distinct from Production.
# Set MONGODB_DB_NAME to the same value as DEV_TEST_VENDOR_DB_NAME.
DEV_TEST_VENDOR_DB_NAME=
PRODUCTION_MONGODB_DB_NAME=
