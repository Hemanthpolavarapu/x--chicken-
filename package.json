{
  "name": "x-chicken-monorepo",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:frontend": "pnpm --filter @x-chicken/frontend dev",
    "dev:backend": "pnpm --filter @x-chicken/backend dev",
    "build": "pnpm --filter @x-chicken/backend build && pnpm --filter @x-chicken/frontend build",
    "build:frontend": "pnpm --filter @x-chicken/frontend build",
    "build:backend": "pnpm --filter @x-chicken/backend build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@11.6.0"
}
