# MongoDB Atlas connection string (server-only)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB database name
MONGODB_DB_NAME=x_chicken

# Comma-separated allowed frontend origins for CORS & CSRF checks
ALLOWED_ORIGINS=http://localhost:3000

# Optional: set to "true" only if production/container DNS blocks SRV lookups
# MONGODB_DNS_FALLBACK=false

# Server-side admin provisioning credentials (used ONLY by `pnpm --filter @x-chicken/backend provision:admin`)
# ADMIN_PROVISION_EMAIL=
# ADMIN_PROVISION_PASSWORD=
# ADMIN_PROVISION_NAME=X-Chicken Admin
